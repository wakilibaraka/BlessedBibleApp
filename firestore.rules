rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- CMS content: world-readable, admin-only writes ----
    match /VOTD/{doc}          { allow read: if true; allow write: if isAdmin(); }
    match /devotionals/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /readingPlans/{doc}  { allow read: if true; allow write: if isAdmin(); }
    match /commentary/{doc}    { allow read: if true; allow write: if isAdmin(); }
    match /pericopes/{doc}     { allow read: if true; allow write: if isAdmin(); }

    // ---- Per-user data: only the signed-in owner, only known paths ----
    // The root doc holds no data today; owners may read it and delete it
    // (account deletion), nothing else.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);

      // Custom reading plans (lib/services/plan_cloud_backup.dart).
      match /plans/{planId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPlan(planId);
      }

      // Cloud sync payloads (lib/services/cloud_sync_service.dart).
      match /sync_data/{docId} {
        allow read, delete: if isOwner(userId)
          && docId in ['bookmarks', 'highlights', 'streak'];
        allow create, update: if isOwner(userId) && validSyncDoc(docId);
      }
    }

    // Anything not matched above is denied by default.

    // ---- Helpers ----
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'dx78nhHTHMNnCLlryAWIwGqqAh23';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validPlan(planId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'title', 'days', 'cadence', 'wasClamped',
                               'clampReason', 'schedule', 'tracks'])
        && d.keys().hasAll(['id', 'title', 'days', 'schedule'])
        && d.id == planId
        && d.title is string && d.title.size() <= 200
        && d.days is int && d.days >= 1 && d.days <= 730
        && d.schedule is list && d.schedule.size() <= 730
        && (!('tracks' in d) || (d.tracks is list && d.tracks.size() <= 20));
    }

    function validSyncDoc(docId) {
      let d = request.resource.data;
      return (docId == 'streak'
          && d.keys().hasOnly(['count', 'last_read'])
          && (!('count' in d) || (d.count is int && d.count >= 0))
          && (!('last_read' in d) || d.last_read is int))
        || (docId in ['bookmarks', 'highlights']
          && d.keys().size() <= 20000);
    }
  }
}
