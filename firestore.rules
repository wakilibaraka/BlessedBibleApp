rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- CMS content: world-readable, admin-only writes ----
    match /VOTD/{doc}          { allow read: if true; allow write: if isAdmin(); }
    match /devotionals/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /readingPlans/{doc}  { allow read: if true; allow write: if isAdmin(); }
    match /commentary/{doc}    { allow read: if true; allow write: if isAdmin(); }
    match /pericopes/{doc}     { allow read: if true; allow write: if isAdmin(); }

    // ---- Per-user data: only the signed-in owner, only known paths ----
    // The root doc is the profile shared with Blessed Arcade
    // (blessed_account SharedProfile): owner-only, validated fields.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;

      // Custom reading plans (lib/services/plan_cloud_backup.dart).
      match /plans/{planId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPlan(planId);
      }

      // Legacy pre-5B sync payloads: no longer written; owners may read
      // and delete them (account deletion).
      match /sync_data/{docId} {
        allow read, delete: if isOwner(userId);
      }

      // Per-item sync (blessed_account SyncEngine, lib/sync/bible_sync.dart):
      // {id, data, updatedAt, deleted, device, syncedAt}.
      match /{col}/{itemId} {
        allow read, delete: if isOwner(userId)
          && col in ['bookmarks', 'folders', 'highlights', 'notes',
                   'custom_plans', 'plan_progress', 'reading_days', 'meta'];
        allow create, update: if isOwner(userId)
          && col in ['bookmarks', 'folders', 'highlights', 'notes',
                   'custom_plans', 'plan_progress', 'reading_days', 'meta']
          && validSyncItem(col, itemId);
      }
    }

    // Anything not matched above is denied by default.

    // ---- Helpers ----
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'dx78nhHTHMNnCLlryAWIwGqqAh23';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validPlan(planId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'title', 'days', 'cadence', 'wasClamped',
                               'clampReason', 'schedule', 'tracks'])
        && d.keys().hasAll(['id', 'title', 'days', 'schedule'])
        && d.id == planId
        && d.title is string && d.title.size() <= 200
        && d.days is int && d.days >= 1 && d.days <= 730
        && d.schedule is list && d.schedule.size() <= 730
        && (!('tracks' in d) || (d.tracks is list && d.tracks.size() <= 20));
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'avatar', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && d.displayName is string
        && d.displayName.size() >= 1 && d.displayName.size() <= 100
        && (!('avatar' in d) || d.avatar == null
            || (d.avatar is string && d.avatar.size() <= 500))
        && d.createdAt is int && d.updatedAt is int;
    }

    function validSyncItem(col, itemId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'data', 'updatedAt', 'deleted', 'device', 'syncedAt'])
        && d.keys().hasAll(['id', 'data', 'updatedAt', 'deleted', 'device', 'syncedAt'])
        && d.id is string && d.id.size() >= 1 && d.id.size() <= 200
        && d.updatedAt is int
        && d.deleted is bool
        && d.device is string && d.device.size() <= 64
        && d.syncedAt == request.time
        && ((d.deleted == true && d.data == null)
          || (d.deleted == false && d.data is map && validItemData(col, itemId, d.data)));
    }

    function optString(m, key, max) {
      return !(key in m) || m[key] == null || (m[key] is string && m[key].size() <= max);
    }

    function validItemData(col, itemId, x) {
      return (col == 'bookmarks'
          && x.keys().hasOnly(['createdAt', 'folderId'])
          && x.createdAt is int
          && optString(x, 'folderId', 200))
        || (col == 'folders'
          && x.keys().hasOnly(['name'])
          && x.name is string && x.name.size() <= 200)
        || (col == 'highlights'
          && x.keys().hasOnly(['color'])
          && x.color is int && x.color >= 0 && x.color <= 20)
        || (col == 'notes'
          && x.keys().hasOnly(['title', 'content', 'date', 'reference'])
          && x.title is string && x.title.size() <= 1000
          && x.content is string && x.content.size() <= 100000
          && x.date is string && x.date.size() <= 100
          && optString(x, 'reference', 500))
        || (col == 'custom_plans'
          && x.keys().hasOnly(['json'])
          && x.json is string && x.json.size() <= 500000)
        || (col == 'plan_progress'
          && x.keys().hasOnly(['json'])
          && x.json is string && x.json.size() <= 200000)
        || (col == 'reading_days'
          && x.keys().size() == 0
          && itemId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        || (col == 'meta' && itemId == 'active_plans'
          && x.keys().hasOnly(['ids'])
          && x.ids is list && x.ids.size() <= 20);
    }
  }
}
